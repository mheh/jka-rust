{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/handoff-absorb.sh",
            "timeout": 15,
            "statusMessage": "Looking for a parked handoff"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit-nudge.sh",
            "timeout": 10,
            "statusMessage": "Audit decision rule"
          }
        ]
      }
    ]
  }
}
