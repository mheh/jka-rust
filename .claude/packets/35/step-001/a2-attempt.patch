+/// Inits one Ghoul2 model through the real client register path.
+///
+/// The client path needs the view's `re` slot seated, so this seats a real [`RendererFrontend`] for the length of the call.
+/// The 12 twin fields swap out of `UiHost`, the 7 frontend-only fields hold their defaults, and the twins swap back before return.
+/// Returns `None` when the model file is absent, which the init reports as a negative model index.
+pub fn init_ghoul2(host: &mut UiHost, name: &str) -> Option<(Ghoul2System, Ghoul2Handle, qhandle_t)> {
+    let mut g2 = Ghoul2System::default();
+    let mut info = CGhoul2Info_v { mItem: 0 };
+    info.alloc(&mut g2);
+
+    // The frontend window opens here and closes at the second swap below.
+    // `RendererFrontend::new` writes no cvar and touches no engine state, so the placeholder twins it builds cost nothing.
+    let mut re = RendererFrontend::new();
+    swap_frontend_twins(host, &mut re);
+
+    let model_index = {
+        // The frontend outlives the view this block builds, so the seated slot stays valid for the whole init call.
+        let re_ptr: *mut RendererFrontend = &mut re;
+        let UiHost { engine, models, .. } = &mut *host;
+        let models_ptr: *mut RenderModels = &mut *models;
+        let Engine { common, cm, sv, .. } = &mut **engine;
+        let sv_ptr: *mut () = sv as *mut Server as *mut ();
+        let mut view = host_view(common, cm, sv_ptr, models_ptr);
+        view.re = SlotRenderer::from_raw(re_ptr as *mut ());
+        g2api_init_ghoul2_model(&mut g2, &mut view, &mut info, name, 0, 0, 0, 0, 0)
+    };
+
+    swap_frontend_twins(host, &mut re);
+
+    if model_index < 0 {
+        return None;
+    }
+
+    let model_handle = info.get(&g2, 0).model;
+    Some((g2, Ghoul2Handle(info.mItem), model_handle))
+}
+
+/// Swaps the 12 carrier fields `UiHost` and [`RendererFrontend`] both hold.
+///
+/// A pair of calls opens and closes one window where the frontend holds the live carriers.
+/// The client register path writes only inside that set, so the swap back discards no mutation.
+fn swap_frontend_twins(host: &mut UiHost, re: &mut RendererFrontend) {
+    swap(&mut host.cvars, &mut re.cvars);
+    swap(&mut host.sim, &mut re.sim);
+    swap(&mut host.img_state, &mut re.img_state);
+    swap(&mut host.frame, &mut re.frame);
+    swap(&mut host.world_load, &mut re.world_load);
+    swap(&mut host.scene, &mut re.scene);
+    swap(&mut host.noise, &mut re.noise);
+    swap(&mut host.rng, &mut re.rng);
+    swap(&mut host.font, &mut re.font);
+    swap(&mut host.world_effects, &mut re.world_effects);
+    swap(&mut host.qs, &mut re.qs);
+    swap(&mut host.sky_view, &mut re.sky_view);
+}
