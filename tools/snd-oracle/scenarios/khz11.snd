# khz11 — S_Init at 11025 Hz. The ring keeps its 65536 bytes, so the mix window
# and every resample ratio change. This is the low half of the s_khz variants.
cvar s_khz 11
init
beginreg
register 0 sound/sine440.wav
register 1 sound/sweep11k.wav
register 2 sound/sine44k.wav
dumpsfx loaded
respatialize 0 0 0 0 0
startsound 0 0 0 1 0 0
startsound 0 0 0 2 0 1
startsound 0 0 0 3 0 2
respatialize 0 0 0 0 0
advance 551
update
dumpstate frame1
dumpring frame1
respatialize 0 0 0 0 0
advance 551
update
dumpstate frame2
dumpring frame2
shutdown
