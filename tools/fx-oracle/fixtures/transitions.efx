// fx-oracle fixture: every transition token in every group. One cylinder per
// token, because the cylinder is the one type that reads all five groups.
// Hand-authored. No retail content.
cylinder
{
	name		t_linear
	count		1
	life		400
	shader		fx/trans/linear
	origin		0 0 0
	rgb
	{
		start	1 1 1
		end		0 0 0
		parm	50
		flags	linear
	}
	alpha
	{
		start	1
		end		0
		parm	50
		flags	linear
	}
	size
	{
		start	4
		end		1
		parm	50
		flags	linear
	}
	size2
	{
		start	8
		end		2
		parm	50
		flags	linear
	}
	length
	{
		start	32
		end		8
		parm	50
		flags	linear
	}
}
